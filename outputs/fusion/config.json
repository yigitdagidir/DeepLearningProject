{
  "dataset": "demo",
  "data_root": "data",
  "image_size": 64,
  "max_text_len": 20,
  "min_word_freq": 1,
  "val_split": 0.15,
  "num_workers": 0,
  "cnn_backbone": "resnet18",
  "pretrained": true,
  "freeze_backbone": true,
  "img_feat_dim": 256,
  "embed_dim": 128,
  "rnn_type": "lstm",
  "rnn_hidden": 256,
  "rnn_layers": 1,
  "bidirectional": true,
  "use_pretrained_embeddings": false,
  "glove_path": "",
  "fusion_hidden": [
    256
  ],
  "dropout": 0.5,
  "modality": "both",
  "epochs": 15,
  "batch_size": 32,
  "lr": 0.001,
  "weight_decay": 0.0001,
  "optimizer": "adam",
  "lr_step": 7,
  "lr_gamma": 0.1,
  "label_smoothing": 0.0,
  "seed": 42,
  "out_dir": "outputs",
  "experiment_name": "fusion"
}